Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 18
Set Width 1100
Set Height 780
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 25ms
Set Framerate 15
Set CursorBlink false
Env PS1 "$ "

Hide
Type "source .venv/bin/activate"
Enter
Type "export PS1='$ '"
Enter
Type "clear"
Enter
Sleep 500ms
Show
Sleep 500ms
