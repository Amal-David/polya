{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Educational method example library",
  "type": "array",
  "minItems": 1,
  "maxItems": 256,
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,79}(?![\\s\\S])"
      },
      "documented_evidence": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30000,
        "pattern": "\\S"
      },
      "reconstruction": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30000,
        "pattern": "\\S"
      },
      "falsifiable_test": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30000,
        "pattern": "\\S"
      },
      "source": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000,
            "pattern": "^https://[^/]+"
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000,
            "pattern": "\\S"
          },
          "license_basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000,
            "pattern": "\\S"
          }
        },
        "required": [
          "url",
          "author",
          "title",
          "license_basis"
        ],
        "additionalProperties": false
      },
      "toy_adaptation": {
        "type": "object",
        "properties": {
          "provenance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000,
            "pattern": "\\S"
          },
          "problem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000,
            "pattern": "\\S"
          },
          "solution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000,
            "pattern": "\\S"
          },
          "verification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000,
            "pattern": "\\S"
          }
        },
        "required": [
          "provenance",
          "problem",
          "solution",
          "verification"
        ],
        "additionalProperties": false
      },
      "methods": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30000,
          "pattern": "\\S"
        },
        "minItems": 1,
        "maxItems": 32
      },
      "applicability": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30000,
          "pattern": "\\S"
        },
        "minItems": 1,
        "maxItems": 32
      },
      "limits": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30000,
          "pattern": "\\S"
        },
        "minItems": 1,
        "maxItems": 32
      }
    },
    "required": [
      "id",
      "documented_evidence",
      "reconstruction",
      "falsifiable_test",
      "source",
      "toy_adaptation",
      "methods",
      "applicability",
      "limits"
    ],
    "additionalProperties": false
  }
}
